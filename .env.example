# Database (npm run db:dev starts a local PostgreSQL on 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/law_office"
POSTGRES_PASSWORD="postgres"

# Host port used by docker compose (loopback only). Change if 3017 is taken.
LAW_FIRM_PORT="3017"

# Auth.js
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# File storage: leave S3_* empty to store files on local disk (./uploads)
S3_ENDPOINT=""
S3_REGION="me-central-1"
S3_BUCKET="law-office"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
MINIO_ROOT_USER="minio"
MINIO_ROOT_PASSWORD="minio-secret"
UPLOAD_DIR="./uploads"

# Background jobs: leave empty to run reminders with `npm run jobs:once` (e.g. Windows Task Scheduler)
REDIS_URL=""

# Email: leave SMTP_HOST empty to log emails to the console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Law Office <no-reply@example.ae>"

# Backups
BACKUP_DIR="./backups"
